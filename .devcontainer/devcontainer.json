{
    "name": "LOG200 - Isolation (Java 25 + Typst + Wine)",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "runServices": ["dev", "server"],
    "workspaceFolder": "/workspaces/LOG200-Isolation",
    "shutdownAction": "stopCompose",
    "forwardPorts": [6080, 8888],
    "portsAttributes": {
        "6080": {
            "label": "Serveur Isolation (GUI)",
            "onAutoForward": "openPreview"
        },
        "8888": {
            "label": "Serveur Isolation (jeu)",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "redhat.java",
                "josevseb.google-java-format-for-vs-code",
                "vscjava.vscode-java-debug",
                "myriad-dreamin.tinymist",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-french",
                "EditorConfig.EditorConfig",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "github.copilot.enable": { "*": false },
                "github.copilot.nextEditSuggestions.enabled": false,
                "editor.inlineSuggest.enabled": false,
                "java.project.sourcePaths": ["src", "test"],
                "java.project.referencedLibraries": ["/opt/junit/*.jar"],
                "java.project.outputPath": "bin",
                "[java]": {
                    "editor.tabSize": 4,
                    "editor.insertSpaces": true,
                    "editor.defaultFormatter": "josevseb.google-java-format-for-vs-code"
                },
                "java.format.settings.google.extra": "--aosp",
                "java.format.settings.google.executable": "/usr/local/bin/google-java-format",
                "tinymist.exportPdf": "onSave",
                "tinymist.rootPath": "${workspaceFolder}",
                "tinymist.formatterMode": "typstyle",
                "[typst]": {
                    "editor.defaultFormatter": "myriad-dreamin.tinymist"
                }
            }
        }
    },
    "postCreateCommand": "java -version && javac -version && typst --version",
    "postAttachCommand": "bash .devcontainer/install-extensions.sh",
    "remoteUser": "vscode"
}
